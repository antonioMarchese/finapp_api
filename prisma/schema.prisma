generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense
  investment
}

enum Currency {
  BRL
  USD
  EUR
  GBP
}

model Transaction {
  id          Int             @id @default(autoincrement())
  description String?
  amount      Float
  currency    Currency        @default(BRL)
  type        TransactionType @default(expense)
  dueDate     DateTime        @updatedAt
  category    Category        @relation(fields: [categoryId], references: [id])

  categoryId Int

  // Set when the transaction was generated from a fixed transaction template,
  // which is how the monthly checklist knows what has already been paid.
  fixedTransaction   FixedTransaction? @relation(fields: [fixedTransactionId], references: [id], onDelete: SetNull)
  fixedTransactionId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model Category {
  id    Int     @id @default(autoincrement())
  title String
  slug  String
  color String?

  transactions      Transaction[]
  fixedTransactions FixedTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug])
  @@map("categories")
}

// A recurring bill (rent, cellphone, electricity) used as a template when
// generating the real transaction for a given month. `amount` is nullable
// because bills like electricity change every month.
model FixedTransaction {
  id       Int             @id @default(autoincrement())
  name     String
  amount   Float?
  currency Currency        @default(BRL)
  type     TransactionType @default(expense)
  dueDay   Int?
  active   Boolean         @default(true)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fixed_transactions")
}

// Single-row table holding app-wide configuration.
model AppSettings {
  id              Int      @id @default(1)
  defaultCurrency Currency @default(BRL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
